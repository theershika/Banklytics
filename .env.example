# Copy to .env; never commit .env. Generate key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-key
DATABASE_URL=mysql+pymysql://accountpulse:CHANGE_ME@127.0.0.1:3306/banking_analysis?charset=utf8mb4
COOKIE_SECURE=false
FLAG_LARGE_THRESHOLD=100000.00
# Local rate limits use process memory. Multi-worker deployments should use Redis.
RATELIMIT_STORAGE_URI=memory://
# Optional: set DEMO_PASSWORD locally for flask --app run.py seed-demo.
# Otherwise the command prompts securely. Never commit demo passwords.
